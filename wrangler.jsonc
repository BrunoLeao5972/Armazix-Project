{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "armazix",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "armazix.com.br/*", "zone_name": "armazix.com.br" },
    { "pattern": "www.armazix.com.br/*", "zone_name": "armazix.com.br" },
    { "pattern": "*.armazix.com.br/*", "zone_name": "armazix.com.br" }
  ],
  "vars": {
    "NODE_ENV": "production"
  },
  // Secrets (set via `wrangler secret put`):
  //   DATABASE_URL              — Neon PostgreSQL connection string
  //   JWT_SECRET                — Auth signing key
  //   ENCRYPTION_KEY            — AES-256 encryption key for sensitive data (mpAccessToken)
  //   MP_WEBHOOK_SECRET         — Mercado Pago webhook signing key (painel MP › Webhooks).
  //                               Usado pelos webhooks de assinatura/PIX, onde quem cobra
  //                               é o Armazix. O webhook de PEDIDOS não usa segredo: a conta
  //                               MP é do lojista, então a notificação é só um gatilho e a
  //                               verdade vem de GET /v1/payments com o token da loja.
  //                               (WEBHOOK_API_KEY foi retirado — não era lido por ninguém.)
  //   PLATFORM_MP_ACCESS_TOKEN  — Mercado Pago token for Armazix platform subscriptions
  //   UPSTASH_REDIS_REST_URL    — https://<id>.upstash.io  (Dashboard › REST API)
  //   UPSTASH_REDIS_REST_TOKEN  — token do Upstash (Dashboard › REST API)
  //
  // Provisionamento Upstash:
  //   1. upstash.com → Create Database → Region: us-east-1 (mais próximo do Neon)
  //   2. wrangler secret put UPSTASH_REDIS_REST_URL
  //   3. wrangler secret put UPSTASH_REDIS_REST_TOKEN
  //   Sem secrets configurados → cache desabilitado, fallback direto ao banco (fail-safe)
  "observability": {
    // Enables Cloudflare Workers Observability: logs, metrics, traces in the dashboard.
    // Security events from logSecurityEvent() are emitted as structured JSON to stdout
    // and captured here for SIEM/alerting via Cloudflare Logpush or Workers Logs.
    "enabled": true,
    "head_sampling_rate": 1  // 100% sampling — capture all requests for security audit trail
  },
}

